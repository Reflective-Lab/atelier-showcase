# scenario-round-driven-formation-design — local dev secrets.
#
# Copy to `.env` (gitignored) and fill in any one provider key. The
# code is provider-agnostic: Manifold selects whichever backend it
# finds a healthy key for. Cloud uses GCP Secret Manager and CI uses
# GitHub Actions secrets — both expose the same env vars without
# this file.

# ── Provider keys ────────────────────────────────────────────────
# Set at least one of these.

# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=AIza...
# OPENROUTER_API_KEY=sk-or-...
# MISTRAL_API_KEY=...

# ── Optional: selection criteria + provider override ─────────────

# CONVERGE_LLM_PROFILE selects the needs spec Manifold ranks against.
# One of: interactive | analysis | batch | high_volume
# Default: interactive
# CONVERGE_LLM_PROFILE=analysis

# CONVERGE_LLM_PROVIDER forces a specific provider even when other
# keys are available. Use only for debugging / cost control; in
# normal use let Manifold pick.
# CONVERGE_LLM_PROVIDER=anthropic
